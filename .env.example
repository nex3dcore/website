# Server configuration
PORT=3001

# Paddle configuration (Sandbox settings)
# Get these from your Paddle Sandbox dashboard
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_your_client_token_here
PADDLE_API_KEY=sec_your_api_key_here
PADDLE_WEBHOOK_SECRET=pdl_ntf_your_webhook_signing_secret_here

# SQLite database file path (optional, defaults to nexdesign.db in server directory)
# For production PostgreSQL: DATABASE_URL=postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite://server/nexdesign.db
